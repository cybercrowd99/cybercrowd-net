{
  "name": "@cybercrowd/xr-room-vr-build",
  "version": "0.1.0",
  "private": true,
  "description": "CyberCrowd XR Room VR browser app.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "lint": "node ./scripts/lint-placeholder.js",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@cybercrowd/xr-core": "workspace:*",
    "@cybercrowd/xr-identity": "workspace:*",
    "@cybercrowd/xr-portal": "workspace:*",
    "@cybercrowd/xr-slam": "workspace:*",
    "@cybercrowd/xr-mapping": "workspace:*",
    "@cybercrowd/xr-swarm": "workspace:*",
    "@cybercrowd/xr-config": "workspace:*"
  },
  "devDependencies": {
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
