{
  "name": "@cybercrowd/swarm",
  "version": "0.1.0",
  "private": true,
  "description": "CyberCrowd swarm engine for coordination, routing, identity mesh, localization, safety, telemetry, and failover.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./swarm-coordinator": "./src/swarm-coordinator.js",
    "./swarm-identity-mesh": "./src/swarm-identity-mesh.js",
    "./swarm-link-router": "./src/swarm-link-router.js",
    "./swarm-task-allocator": "./src/swarm-task-allocator.js",
    "./swarm-localizer": "./src/swarm-localizer.js",
    "./swarm-collision-guard": "./src/swarm-collision-guard.js",
    "./swarm-health-monitor": "./src/swarm-health-monitor.js",
    "./swarm-failover-manager": "./src/swarm-failover-manager.js",
    "./swarm-sim-validator": "./src/swarm-sim-validator.js",
    "./swarm-telemetry-bus": "./src/swarm-telemetry-bus.js",
    "./swarm-constraints": "./src/swarm-constraints.js"
  },
  "scripts": {
    "build": "node -e \"console.log('swarm build complete')\"",
    "test": "vitest run",
    "lint": "node -e \"console.log('swarm lint placeholder')\"",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@cybercrowd/core": "workspace:*",
    "@cybercrowd/identity": "workspace:*",
    "@cybercrowd/portal": "workspace:*",
    "@cybercrowd/mapping": "workspace:*",
    "@cybercrowd/config": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
