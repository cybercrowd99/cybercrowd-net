const fs = require("fs");
const path = require("path");

const RETENTION_POLICY_PATH =
path.join(
    __dirname,
    "retention-policy.json"
);

let cachedPolicy = null;

function loadRetentionPolicy() {

    try {

        const raw =
        fs.readFileSync(
            RETENTION_POLICY_PATH,
            "utf8"
        );

        cachedPolicy =
        JSON.parse(raw);

        console.log(
            "RETENTION POLICY LOADED"
        );

        return cachedPolicy;

    } catch (err) {

        console.log(
            "RETENTION POLICY LOAD FAILED"
        );

        console.log(err);

        return null;
    }
}

function getRetentionPolicy() {

    if (!cachedPolicy) {

        return loadRetentionPolicy();
    }

    return cachedPolicy;
}

function reloadRetentionPolicy() {

    cachedPolicy = null;

    return loadRetentionPolicy();
}

function isRetentionAllowed(eventType) {

    const policy =
    getRetentionPolicy();

    if (
        !policy ||
        !policy.allowed_retention
    ) {

        return false;
    }

    return !!(
        policy.allowed_retention[eventType]
    );
}

function isRetentionForbidden(eventType) {

    const policy =
    getRetentionPolicy();

    if (
        !policy ||
        !policy.forbidden_retention
    ) {

        return false;
    }

    return !!(
        policy.forbidden_retention[eventType]
    );
}

module.exports = {
    loadRetentionPolicy,
    getRetentionPolicy,
    reloadRetentionPolicy,
    isRetentionAllowed,
    isRetentionForbidden
};
