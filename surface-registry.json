{
  "registry_name": "Cybercrowd Surface Registry",
  "version": "V2",

  "surfaces": {
    "laptop": {
      "id": "laptop",
      "label": "Laptop Surface",
      "type": "primary",
      "route": "/",
      "trusted": true,
      "can_own_control": true,
      "can_watch": true,
      "can_move_pointer": false,
      "status": "online"
    },

    "phone": {
      "id": "phone",
      "label": "Phone Surface",
      "type": "mobile",
      "route": "/client",
      "trusted": true,
      "can_own_control": true,
      "can_watch": true,
      "can_move_pointer": true,
      "status": "online"
    }
  },

  "ownership": {
    "current_owner": "phone",
    "fallback_owner": "laptop",
    "ownership_transfer_enabled": true
  },

  "tabletop_trial": {
    "enabled": true,
    "mode": "behavior-testing",
    "allow_multi_surface_testing": true,
    "allow_live_transfer": true
  },

  "doctrine": [
    "multi-device awareness",
    "trusted surfaces only",
    "interaction ownership must be visible",
    "watching is not the same as controlling",
    "serviceable surface registry",
    "tabletop operational behavior testing"
  ]
}