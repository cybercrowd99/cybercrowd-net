{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybercrowd.net/schemas/drop-device-event-schema.v1.json",
  "title": "Cybercrowd DROP DEVICE EVENT SCHEMA V1",
  "description": "Canonical event schema for Cybercrowd cross-device pointer, control, HID bridge, clipboard, drag-transfer, pairing, authorization, safety stop, and ledger recording.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event",
    "ledger",
    "origin",
    "target",
    "session",
    "security",
    "payload"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "status",
        "namespace"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "DROP_DEVICE_EVENT_SCHEMA"
        },
        "version": {
          "type": "string",
          "const": "1.0.0"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "active",
            "deprecated",
            "locked"
          ],
          "default": "active"
        },
        "namespace": {
          "type": "string",
          "const": "cybercrowd.device.drop"
        },
        "created_by": {
          "type": "string",
          "default": "Cybercrowd"
        },
        "created_for": {
          "type": "string",
          "default": "Magic Cursor / Cross-Device HID Bridge"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "event_family",
        "event_status",
        "created_at"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 12,
          "maxLength": 128,
          "description": "Unique event identifier. Recommended format: evt_ulid_or_uuid."
        },
        "parent_event_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "event_type": {
          "type": "string",
          "enum": [
            "PAIRING_REQUEST",
            "PAIRING_ACCEPTED",
            "PAIRING_REJECTED",
            "PAIRING_EXPIRED",
            "SESSION_OPENED",
            "SESSION_REFRESHED",
            "SESSION_CLOSED",
            "DEVICE_DISCOVERED",
            "DEVICE_REGISTERED",
            "DEVICE_VERIFIED",
            "DEVICE_REVOKED",
            "POINTER_ENTER",
            "POINTER_EXIT",
            "POINTER_MOVE",
            "POINTER_DOWN",
            "POINTER_UP",
            "POINTER_CLICK",
            "POINTER_DOUBLE_CLICK",
            "POINTER_SCROLL",
            "POINTER_DRAG_START",
            "POINTER_DRAG_MOVE",
            "POINTER_DRAG_DROP",
            "POINTER_DRAG_CANCEL",
            "KEY_DOWN",
            "KEY_UP",
            "TEXT_INPUT",
            "HID_COMMAND",
            "CLIPBOARD_OFFER",
            "CLIPBOARD_ACCEPTED",
            "CLIPBOARD_REJECTED",
            "CLIPBOARD_TRANSFER",
            "FILE_OFFER",
            "FILE_ACCEPTED",
            "FILE_REJECTED",
            "FILE_TRANSFER_START",
            "FILE_TRANSFER_PROGRESS",
            "FILE_TRANSFER_COMPLETE",
            "FILE_TRANSFER_FAILED",
            "CONTROL_COMMAND",
            "AUDIO_ROUTE_EVENT",
            "CAMERA_ROUTE_EVENT",
            "ACCESSIBILITY_EVENT",
            "LEDGER_NOTE",
            "SECURITY_ALERT",
            "SAFETY_STOP",
            "KILL_STOP",
            "ERROR",
            "HEARTBEAT"
          ]
        },
        "event_family": {
          "type": "string",
          "enum": [
            "pairing",
            "session",
            "device",
            "pointer",
            "keyboard",
            "hid",
            "clipboard",
            "file",
            "control",
            "media",
            "accessibility",
            "security",
            "ledger",
            "system"
          ]
        },
        "event_status": {
          "type": "string",
          "enum": [
            "created",
            "queued",
            "sent",
            "received",
            "validated",
            "applied",
            "rejected",
            "failed",
            "expired",
            "archived"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "received_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "description": "Monotonic sequence number inside the active session."
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "normal",
            "high",
            "critical"
          ],
          "default": "normal"
        },
        "ttl_ms": {
          "type": "integer",
          "minimum": 0,
          "default": 30000
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledger_id",
        "ledger_mode",
        "write_policy",
        "integrity"
      ],
      "properties": {
        "ledger_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "ledger_mode": {
          "type": "string",
          "enum": [
            "local_only",
            "session_chain",
            "cloud_anchor",
            "hardware_anchor",
            "full_audit"
          ],
          "default": "session_chain"
        },
        "write_policy": {
          "type": "string",
          "enum": [
            "append_only",
            "append_with_redaction_pointer",
            "ephemeral",
            "debug_only"
          ],
          "default": "append_only"
        },
        "previous_hash": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "event_hash": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "chain_index": {
          "type": "integer",
          "minimum": 0
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hash_algorithm",
            "signature_required",
            "tamper_response"
          ],
          "properties": {
            "hash_algorithm": {
              "type": "string",
              "enum": [
                "SHA-256",
                "SHA-384",
                "SHA-512",
                "BLAKE3"
              ],
              "default": "SHA-256"
            },
            "signature_required": {
              "type": "boolean",
              "default": true
            },
            "signature_algorithm": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "Ed25519",
                "ECDSA-P256",
                "RSA-PSS",
                null
              ],
              "default": "Ed25519"
            },
            "signature": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2048
            },
            "tamper_response": {
              "type": "string",
              "enum": [
                "log_only",
                "quarantine_event",
                "close_session",
                "revoke_device",
                "kill_stop"
              ],
              "default": "quarantine_event"
            }
          }
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "retention_class": {
              "type": "string",
              "enum": [
                "ephemeral",
                "short_audit",
                "standard_audit",
                "legal_hold",
                "development_archive"
              ],
              "default": "standard_audit"
            },
            "retention_days": {
              "type": "integer",
              "minimum": 0,
              "default": 365
            },
            "contains_sensitive_data": {
              "type": "boolean",
              "default": false
            }
          }
        }
      }
    },
    "origin": {
      "$ref": "#/$defs/device_endpoint"
    },
    "target": {
      "$ref": "#/$defs/device_endpoint"
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "pairing_id",
        "session_state",
        "transport",
        "permissions"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "pairing_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "session_state": {
          "type": "string",
          "enum": [
            "pending",
            "active",
            "paused",
            "closing",
            "closed",
            "revoked",
            "expired"
          ]
        },
        "pairing_method": {
          "type": "string",
          "enum": [
            "qr_code",
            "manual_code",
            "local_discovery",
            "nfc",
            "hardware_token",
            "trusted_account"
          ],
          "default": "qr_code"
        },
        "pairing_code_hash": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "transport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "channel_security"
          ],
          "properties": {
            "protocol": {
              "type": "string",
              "enum": [
                "tcp",
                "udp",
                "websocket",
                "webrtc_datachannel",
                "bluetooth_le",
                "usb",
                "local_loopback"
              ]
            },
            "host": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 255
            },
            "port": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 65535
            },
            "channel_security": {
              "type": "string",
              "enum": [
                "none_dev_only",
                "tls",
                "dtls",
                "noise_protocol",
                "webrtc_secure",
                "hardware_bound"
              ],
              "default": "tls"
            },
            "network_scope": {
              "type": "string",
              "enum": [
                "same_device",
                "same_lan",
                "trusted_lan",
                "internet_relay",
                "offline_hardware"
              ],
              "default": "same_lan"
            }
          }
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pointer",
            "keyboard",
            "clipboard",
            "file_transfer",
            "media_control",
            "system_control"
          ],
          "properties": {
            "pointer": {
              "$ref": "#/$defs/permission_state"
            },
            "keyboard": {
              "$ref": "#/$defs/permission_state"
            },
            "clipboard": {
              "$ref": "#/$defs/permission_state"
            },
            "file_transfer": {
              "$ref": "#/$defs/permission_state"
            },
            "media_control": {
              "$ref": "#/$defs/permission_state"
            },
            "system_control": {
              "$ref": "#/$defs/permission_state"
            },
            "accessibility_control": {
              "$ref": "#/$defs/permission_state"
            },
            "hardware_anchor": {
              "$ref": "#/$defs/permission_state"
            }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auth_state",
        "authorization_scope",
        "input_safety",
        "audit_logging"
      ],
      "properties": {
        "auth_state": {
          "type": "string",
          "enum": [
            "unauthenticated",
            "pairing_pending",
            "authenticated",
            "verified",
            "rejected",
            "revoked"
          ]
        },
        "authorization_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "read_device_state",
              "send_pointer",
              "send_keyboard",
              "send_text",
              "send_clipboard",
              "send_file",
              "control_audio",
              "control_camera",
              "control_accessibility",
              "control_session",
              "write_ledger",
              "admin_revoke",
              "admin_kill_stop"
            ]
          },
          "uniqueItems": true
        },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "actor_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "actor_role": {
              "type": "string",
              "enum": [
                "owner",
                "trusted_user",
                "guest",
                "observer",
                "admin",
                "system",
                "unknown"
              ],
              "default": "unknown"
            },
            "presence_confirmed": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "input_safety": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rate_limit_applied",
            "allowed_zone_check",
            "dangerous_action_check"
          ],
          "properties": {
            "rate_limit_applied": {
              "type": "boolean"
            },
            "max_events_per_second": {
              "type": "integer",
              "minimum": 1,
              "default": 120
            },
            "allowed_zone_check": {
              "type": "boolean"
            },
            "dangerous_action_check": {
              "type": "boolean"
            },
            "dangerous_action_result": {
              "type": "string",
              "enum": [
                "not_applicable",
                "allowed",
                "requires_confirmation",
                "blocked"
              ],
              "default": "not_applicable"
            },
            "kill_phrase_detected": {
              "type": "boolean",
              "default": false
            },
            "kill_phrase": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            }
          }
        },
        "audit_logging": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "level"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "level": {
              "type": "string",
              "enum": [
                "none",
                "minimal",
                "standard",
                "full",
                "forensic"
              ],
              "default": "standard"
            },
            "redact_clipboard_content": {
              "type": "boolean",
              "default": true
            },
            "redact_file_names": {
              "type": "boolean",
              "default": false
            },
            "redact_text_input": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    },
    "payload": {
      "oneOf": [
        {
          "$ref": "#/$defs/pairing_payload"
        },
        {
          "$ref": "#/$defs/session_payload"
        },
        {
          "$ref": "#/$defs/device_payload"
        },
        {
          "$ref": "#/$defs/pointer_payload"
        },
        {
          "$ref": "#/$defs/keyboard_payload"
        },
        {
          "$ref": "#/$defs/hid_payload"
        },
        {
          "$ref": "#/$defs/clipboard_payload"
        },
        {
          "$ref": "#/$defs/file_payload"
        },
        {
          "$ref": "#/$defs/control_payload"
        },
        {
          "$ref": "#/$defs/media_payload"
        },
        {
          "$ref": "#/$defs/accessibility_payload"
        },
        {
          "$ref": "#/$defs/security_payload"
        },
        {
          "$ref": "#/$defs/system_payload"
        }
      ]
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "server_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "latency_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "clock_skew_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "battery_percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "network_strength": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "unknown",
            "poor",
            "fair",
            "good",
            "excellent",
            null
          ]
        },
        "debug_note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        }
      }
    }
  },
  "$defs": {
    "permission_state": {
      "type": "string",
      "enum": [
        "disabled",
        "ask_each_time",
        "session_allowed",
        "always_allowed",
        "blocked"
      ]
    },
    "device_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "device_role",
        "device_type",
        "platform",
        "trust_state"
      ],
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "device_label": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "device_role": {
          "type": "string",
          "enum": [
            "server",
            "client",
            "controller",
            "receiver",
            "relay",
            "observer",
            "hardware_anchor",
            "unknown"
          ]
        },
        "device_type": {
          "type": "string",
          "enum": [
            "laptop",
            "desktop",
            "phone",
            "tablet",
            "wearable",
            "camera",
            "audio_controller",
            "hardware_module",
            "browser",
            "virtual_device",
            "unknown"
          ]
        },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "os",
            "runtime"
          ],
          "properties": {
            "os": {
              "type": "string",
              "enum": [
                "windows",
                "macos",
                "linux",
                "android",
                "ios",
                "chromeos",
                "browser_only",
                "embedded",
                "unknown"
              ]
            },
            "os_version": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "runtime": {
              "type": "string",
              "enum": [
                "native_app",
                "browser",
                "pwa",
                "python_node",
                "nodejs",
                "embedded_firmware",
                "unknown"
              ]
            },
            "runtime_version": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            }
          }
        },
        "trust_state": {
          "type": "string",
          "enum": [
            "unknown",
            "untrusted",
            "pairing_pending",
            "trusted_session",
            "trusted_persistent",
            "revoked",
            "quarantined"
          ]
        },
        "public_key_fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "screen": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width_px": {
              "type": "integer",
              "minimum": 0
            },
            "height_px": {
              "type": "integer",
              "minimum": 0
            },
            "scale": {
              "type": "number",
              "minimum": 0
            },
            "orientation": {
              "type": "string",
              "enum": [
                "portrait",
                "landscape",
                "square",
                "unknown"
              ],
              "default": "unknown"
            }
          }
        },
        "input_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pointer",
              "touch",
              "keyboard",
              "clipboard",
              "file_drag",
              "audio",
              "camera",
              "speech_to_text",
              "blind_mode",
              "haptics",
              "hardware_button"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "space"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "space": {
          "type": "string",
          "enum": [
            "screen_px",
            "normalized_0_1",
            "viewport_px",
            "element_local_px",
            "virtual_canvas"
          ]
        },
        "z": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "pairing_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_type",
        "pairing_action"
      ],
      "properties": {
        "payload_type": {
          "type": "string",
          "const": "pairing"
        },
        "pairing_action": {
          "type": "string",
          "enum": [
            "request",
            "accept",
            "reject",
            "expire",
            "rotate_code",
            "verify_device"
          ]
        },
        "qr_data_hash": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "human_readable_code_hash": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "requested_permissions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "pairing_reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        }
      }
    },
    "session_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_type",
        "session_action"
      ],
      "properties": {
        "payload_type": {
          "type": "string",
          "const": "session"
        },
        "session_action": {
          "type": "string",
          "enum": [
            "open",
            "refresh",
            "pause",
            "resume",
            "close",
            "expire",
            "revoke"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        }
      }
    },
    "device_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_type",
        "device_action"
      ],
      "properties": {
        "payload_type": {
          "type": "string",
          "const": "device"
        },
        "device_action": {
          "type": "string",
          "enum": [
            "discover",
            "register",
            "verify",
            "update_capabilities",
            "revoke",
            "quarantine"
          ]
        },
        "capability_delta": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "reason": {
